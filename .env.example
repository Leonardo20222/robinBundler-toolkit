# Network: mainnet | testnet
BUNDLER_NETWORK=testnet

# Execution mode: simulation | live
BUNDLER_MODE=simulation

# Primary RPC (Alchemy recommended). Falls back to public RPC if unset.
RPC_URL=
RPC_URL_SECONDARY=
WS_URL=

# Optional Alchemy key — used to build provider URLs when RPC_URL is empty
ALCHEMY_API_KEY=

# Wallet encryption passphrase (required for encrypt/decrypt)
WALLET_PASSPHRASE=change-me-to-a-strong-passphrase

# Parallel workers for bundle execution
MAX_CONCURRENCY=5

# Minimum ETH to keep on each wallet for gas (ether units)
MIN_GAS_ETH=0.002

# Slippage bps for swaps (100 = 1%)
DEFAULT_SLIPPAGE_BPS=100

# Data directory for wallets, bundles, tx history
DATA_DIR=./data

# Submit signed txs via Robinhood sequencer (FCFS latency path)
USE_SEQUENCER=false
# Optional override; defaults to network sequencer URL from docs
SEQUENCER_URL=

# Optional live DEX (Uniswap V2–compatible)
# DEX_ROUTER_ADDRESS=0x...
# WETH_ADDRESS=0x...
