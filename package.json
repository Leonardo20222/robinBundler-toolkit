{
  "name": "robinhood-token-bundler",
  "version": "1.0.0",
  "description": "Multi-wallet transaction orchestration bundler for Robinhood Chain",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bundler": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "wallet:create": "tsx src/cli/index.ts wallet create",
    "bundle:list": "tsx src/cli/index.ts bundle list"
  },
  "keywords": [
    "robinhood-chain",
    "evm",
    "bundler",
    "viem"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "viem": "^2.23.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
